{
  "name": "yungangdotcom",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",

  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
